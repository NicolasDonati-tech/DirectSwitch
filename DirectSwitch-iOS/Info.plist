	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2026 Nicolas Donati. Tutti i diritti riservati.</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSBonjourServices</key>
	<array>
		<string>_directswitch._tcp</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>DirectSwitch utilizza la rete Wi-Fi locale per trasferire i tuoi dati ad alta velocità direttamente tra i due telefoni senza passare dal cloud.</string>
	<key>NSContactsUsageDescription</key>
	<string>DirectSwitch legge e unisce la Rubrica sul nuovo telefono evitando duplicati.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>DirectSwitch accede a foto e video per trasferirli mantenendo data di scatto, posizione GPS e Album.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>DirectSwitch salva nel Rullino le foto e i video ricevuti dal vecchio telefono.</string>
	<key>NSCalendarsUsageDescription</key>
	<string>DirectSwitch trasferisce gli appuntamenti del Calendario sul nuovo telefono.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>DirectSwitch legge e importa gli appuntamenti del Calendario evitando eventi duplicati sul nuovo telefono.</string>
	<key>NSCalendarsWriteOnlyAccessUsageDescription</key>
	<string>DirectSwitch salva gli appuntamenti ricevuti nel Calendario del nuovo telefono.</string>
	<key>NSRemindersUsageDescription</key>
	<string>DirectSwitch trasferisce le liste e i promemoria sul nuovo iPhone senza usare iCloud.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>DirectSwitch legge e importa tutti i promemoria sul nuovo iPhone evitando duplicati.</string>
	<key>NSCameraUsageDescription</key>
	<string>DirectSwitch utilizza la fotocamera per inquadrare il codice QR del telefono ricevente.</string>
