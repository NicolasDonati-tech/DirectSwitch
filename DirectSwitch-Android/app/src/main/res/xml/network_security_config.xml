<?xml version="1.0" encoding="utf-8"?>
<!--
  DirectSwitch opera esclusivamente su socket diretti LAN/Hotspot IPv4 privati (10/8, 172.16/12, 192.168/16, 169.254/16),
  filtrati programmaticamente in LocalNetworkAddresses.isLocalNetworkIpv4, con payload interamente cifrato e autenticato
  end-to-end tramite AES-256-GCM (CSGCM1). Non si accettano certificati utente di terze parti.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
